[Unit]
Description=RECORD remote file application
After=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/REPORT
EnvironmentFile=/home/pi/REPORT/.env
ExecStart=/usr/bin/python3 /home/pi/REPORT/server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
